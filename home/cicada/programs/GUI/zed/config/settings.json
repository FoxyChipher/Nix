{
  "languages": {
    "Nix": {
      "tab_size": 2,
      "formatter": "language_server",
      "format_on_save": "on",
      "language_servers": ["nixd", "!nil"]
    }
  },
  "terminal": {
    "font_size": 12.0
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "show_edit_predictions": false,
  "collaboration_panel": {
    "button": false
  },
  "project_panel": {
    "dock": "left"
  },
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "window_decorations": "server",
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "GitHub Dark"
  },
  "lsp": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["--quiet", "--"]
        }
      }
    },
    "nil": {
      "initialization_options": {
        "formatting": {
          "command": ["alejandra", "--quiet", "--"]
        }
      },
      "settings": {
        "diagnostic": {
          "suppress": ["sema-extra-with"]
        }
      }
    },
    "nixd": {
      "initialization_options": {
        "formatting": {
          "command": ["nixfmt"]
        }
      }
    }
  }
}
