layer-rule {
    place-within-backdrop false
    match namespace="^awww-daemon$"
}

layer-rule {
    match namespace="wofi"
    geometry-corner-radius 12
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.5
    }
}

layer-rule {
    match namespace="logout_dialog"
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.5
    }
}

layer-rule {
    match namespace="launcher"
    geometry-corner-radius 10
    background-effect {
        xray false
        blur true
        noise 0.02
        saturation 1.5
    }
}

